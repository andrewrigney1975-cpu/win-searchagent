<Window
    x:Class="Delve.Views.SearchPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Delve.Models"
    mc:Ignorable="d"
    >
    <Grid x:Name="RootGrid" CornerRadius="8" Padding="0" KeyDown="RootGrid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox
            x:Name="QueryBox"
            Grid.Row="0"
            PlaceholderText="Search Docket's index…"
            FontSize="22"
            BorderThickness="0"
            Padding="16,14"
            TextChanged="QueryBox_TextChanged"
            />

        <ListView
            x:Name="ResultsList"
            Grid.Row="1"
            MaxHeight="420"
            SelectionMode="Single"
            IsItemClickEnabled="True"
            ItemClick="ResultsList_ItemClick"
            Visibility="Collapsed"
            >
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:SearchResultViewModel">
                    <Grid Padding="12,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Grid.Column="0"
                            Width="20"
                            Height="20"
                            Source="{x:Bind Icon, Mode=OneWay}"
                            />
                        <StackPanel Grid.Column="1" Spacing="0">
                            <TextBlock Text="{x:Bind Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{x:Bind DirectoryPath}"
                                FontSize="12"
                                Opacity="0.65"
                                TextTrimming="CharacterEllipsis"
                                />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
