<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    >
    <!-- IconSource is set programmatically in App.xaml.cs (InitializeTrayIcon /
         OnAvailabilityChanged) from an absolute path under AppContext.BaseDirectory - this app
         is unpackaged (WindowsPackageType=None), so a relative XAML resource path here isn't a
         reliable resolution target. -->
    <tb:TaskbarIcon
        x:Key="TrayIcon"
        ToolTipText="Delve — Docket search index not available"
        >
        <tb:TaskbarIcon.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="Open" />
                <MenuFlyoutItem Text="Hide" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Quit" />
            </MenuFlyout>
        </tb:TaskbarIcon.ContextFlyout>
    </tb:TaskbarIcon>
</ResourceDictionary>
